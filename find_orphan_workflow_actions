"""
find_orphan_workflow_actions.py  (Requirement 2)
────────────────────────────────────────────────
Fetches ALL Workflow Actions of every type that are NOT linked to any
Workflow Rule.

Action types covered
--------------------
  WorkflowAlert        → Email Alert
  WorkflowFieldUpdate  → Field Update
  WorkflowOutboundMessage → Outbound Message
  WorkflowTask         → Task
  WorkflowSend         → (legacy) Send Action

Requirements:
    pip install requests

Usage:
    python find_orphan_workflow_actions.py
"""

